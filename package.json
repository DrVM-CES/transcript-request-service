{
  "name": "transcript-request",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "setup:production": "powershell -ExecutionPolicy Bypass -File ./setup-production.ps1",
    "migrate:production": "node migrate-production-db.js",
    "test:production": "node test-production-setup.js",
    "deploy": "npm run build && netlify deploy --prod",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@libsql/client": "0.10.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "next": "15.5.24",
    "pdf-lib": "^1.17.1",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.3.0",
    "resend": "^6.5.0",
    "ssh2-sftp-client": "^10.0.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.24.0",
    "eslint": "^8",
    "eslint-config-next": "15.5.24"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "next@15.5.24": {
      "postcss": "$postcss"
    },
    "drizzle-orm": {
      "kysely": "0.28.17"
    }
  }
}
